swagger: "2.0"
info:
  title: health-data-pipeline-public
  description: Public routes for the personal health data pipeline
  version: "1.0.0"
schemes:
  - https
x-google-backend:
  address: ${backend_url}
  jwt_audience: ${backend_url}
  path_translation: APPEND_PATH_TO_ADDRESS
paths:
  /healthz:
    get:
      operationId: healthz
      responses:
        "200":
          description: Service is healthy
  /webhooks/google-health:
    post:
      operationId: googleHealthWebhook
      responses:
        "201":
          description: Endpoint verification accepted
        "204":
          description: Webhook accepted
  /public/steps.svg:
    get:
      operationId: publicSteps
      produces:
        - image/svg+xml
      responses:
        "200":
          description: Seven-day steps summary
  /setup:
    get:
      operationId: setup
      produces:
        - text/html
      responses:
        "200":
          description: Setup form
  /setup/session:
    post:
      operationId: setupSession
      consumes:
        - application/x-www-form-urlencoded
      responses:
        "303":
          description: Setup session created
  /setup/oauth/start:
    get:
      operationId: oauthStart
      responses:
        "303":
          description: Redirect to Google OAuth
  /setup/oauth/callback:
    get:
      operationId: oauthCallback
      parameters:
        - in: query
          name: code
          type: string
          required: false
        - in: query
          name: state
          type: string
          required: false
        - in: query
          name: error
          type: string
          required: false
      responses:
        "200":
          description: OAuth setup completed
